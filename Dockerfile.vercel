FROM dunglas/frankenphp:1-php8.4-alpine AS base
WORKDIR /app
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_mysql mbstring bcmath intl zip opcache

FROM base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --no-scripts --optimize-autoloader

FROM base AS runtime
COPY --from=dependencies /app/vendor ./vendor
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database/migrations ./database/migrations
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY artisan ./artisan
COPY composer.json composer.lock ./
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.sh /usr/local/bin/membership-entrypoint
RUN mkdir -p storage/framework/cache/data storage/framework/views storage/framework/sessions storage/logs \
    && php artisan package:discover --ansi \
    && chmod +x /usr/local/bin/membership-entrypoint
ENV PORT=80 APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr \
    SESSION_DRIVER=database CACHE_STORE=database QUEUE_CONNECTION=sync \
    SESSION_SECURE_COOKIE=true SESSION_ENCRYPT=true VERCEL=1 \
    LARAVEL_STORAGE_PATH=/tmp/membership-storage \
    MYSQL_ATTR_SSL_CA=/tmp/aiven-ca.pem \
    XDG_CONFIG_HOME=/tmp/caddy-config XDG_DATA_HOME=/tmp/caddy-data
ENTRYPOINT ["/usr/local/bin/membership-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
